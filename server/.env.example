# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# MongoDB connection string. Leave unset during early scaffolding — the
# server starts without a DB connection and logs a warning instead of
# crashing, so you can develop the API surface before provisioning Mongo.
MONGODB_URI=

# Anthropic API key — required once the explainable-scoring engine (the
# core IP of Stratara) starts making LLM calls. Not used yet.
ANTHROPIC_API_KEY=
